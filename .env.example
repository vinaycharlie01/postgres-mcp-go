# MCP Microsoft SQL Server Server — environment configuration example.
# Copy to .env (or export these) and adjust for your environment.
# Environment variables override values in config.yaml.

# ============================================
# SQL Server connection (required)
# ============================================
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=readonly_user
SQLSERVER_PASSWORD=change-me
SQLSERVER_DB=MyDatabase

# TLS for the connection: "true", "false" or "disable".
SQLSERVER_ENCRYPT=true
# Skip server certificate validation (dev only).
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
# Login timeout in seconds.
SQLSERVER_CONNECTION_TIMEOUT=30

# ============================================
# Always Encrypted (optional)
# ============================================
# When enabled, the column master key is loaded from a local PFX certificate.
SQLSERVER_ALWAYS_ENCRYPTED_ENABLED=false
SQLSERVER_ALWAYS_ENCRYPTED_KEY_PATH=
SQLSERVER_ALWAYS_ENCRYPTED_KEY_PASSWORD=

# ============================================
# Query safety limits
# ============================================
QUERY_MAX_LENGTH=5000
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# ============================================
# Connection pool
# ============================================
POOL_MAX_OPEN_CONNS=10
POOL_MAX_IDLE_CONNS=5
POOL_CONN_MAX_LIFETIME_SECONDS=3600

# ============================================
# Logging
# ============================================
# Level: debug, info, warn, error
LOG_LEVEL=info
# Format: json, text
LOG_FORMAT=json

# ============================================
# MCP
# ============================================
# Transport: stdio (recommended) or http
MCP_TRANSPORT=stdio
MCP_PORT=9090
