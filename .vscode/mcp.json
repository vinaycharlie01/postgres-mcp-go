{
  // VS Code MCP config. On first start, VS Code prompts for the values below.
  // Open this folder (postgres-mcp-go) as the workspace, then run the server from
  // the "MCP: List Servers" command or the Start button shown above the
  // "servers" entry. Logs appear in the MCP output channel (stderr).
  "inputs": [
    {
      "type": "promptString",
      "id": "postgres-host",
      "description": "PostgreSQL host (e.g. localhost or db.internal)"
    },
    {
      "type": "promptString",
      "id": "postgres-port",
      "description": "PostgreSQL port",
      "default": "5432"
    },
    {
      "type": "promptString",
      "id": "postgres-user",
      "description": "PostgreSQL login (read-only user recommended)"
    },
    {
      "type": "promptString",
      "id": "postgres-password",
      "description": "PostgreSQL password",
      "password": true
    },
    {
      "type": "promptString",
      "id": "postgres-db",
      "description": "Database name"
    },
    {
      "type": "promptString",
      "id": "postgres-ssl-mode",
      "description": "SSL mode (disable, allow, prefer, require, verify-ca, verify-full)",
      "default": "disable"
    },
    {
      "type": "promptString",
      "id": "postgres-search-path",
      "description": "Search path (default: public)",
      "default": "public"
    }
  ],
  "servers": {
    "postgres-readonly": {
      "type": "stdio",
      "command": "go run ${workspaceFolder}/cmd/server/main.go",
      "env": {
        "POSTGRES_HOST": "${input:postgres-host}",
        "POSTGRES_PORT": "${input:postgres-port}",
        "POSTGRES_USER": "${input:postgres-user}",
        "POSTGRES_PASSWORD": "${input:postgres-password}",
        "POSTGRES_DB": "${input:postgres-db}",
        "POSTGRES_SSL_MODE": "${input:postgres-ssl-mode}",
        "POSTGRES_SEARCH_PATH": "${input:postgres-search-path}",
        "LOG_LEVEL": "info",
        "LOG_FORMAT": "text",
        "LOG_FILE": "${workspaceFolder}/mcp-postgres.log",
        "MCP_TRANSPORT": "stdio"
      }
    }
  }
}

