# MCP PostgreSQL Server configuration (Read-Only Mode)
# Copy to config.yaml and adjust. Environment variables override these values,
# so secrets can be injected at runtime instead of stored here.

database:
  host: "localhost"
  port: 5432
  user: "readonly_user"
  password: ""            # prefer POSTGRES_PASSWORD env var
  database: "postgres"
  ssl_mode: "disable"      # "disable", "allow", "prefer", "require", "verify-ca", "verify-full"
  search_path: "public"
  connection_timeout: 30   # seconds

# Read-only query safety limits.
query:
  max_length: 5000         # characters
  max_rows: 1000           # rows returned
  timeout: 30s             # per-query execution timeout

# Connection pool tuning.
pool:
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime: 1h

logging:
  level: "info"            # debug, info, warn, error
  format: "json"           # json, text

mcp:
  transport: "stdio"       # stdio (recommended) or http
  port: 9090

